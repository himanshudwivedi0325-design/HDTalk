# =============================================================================
# HDTalk Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values before running.
# NEVER commit your actual .env file to version control.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Comma-separated list of allowed frontend origins (or * for all)
CLIENT_URL=https://yourdomain.com

# ─── Security Secrets (REQUIRED in production) ────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_64_CHAR_HEX_SECRET

JWT_EXPIRES_IN=7d

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (optional — app works with JSON fallback if not set)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ─── Storage Paths ────────────────────────────────────────────────────────────
DATA_DIR=./data
UPLOAD_DIR=./uploads

# ─── Web Push / VAPID (REQUIRED for push notifications) ──────────────────────
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@yourdomain.com

# ─── n8n Automation ───────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hdtalk
N8N_ENABLED=true

# ─── Cloudinary Media Storage (optional) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── WebRTC STUN & TURN Infrastructure ────────────────────────────────────────
# Comma-separated list of STUN servers (defaults to Google public STUN if unset)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Dedicated Coturn server credentials (UDP, TCP, and TLS endpoints)
TURN_URL_UDP=turn:turn.yourdomain.com:3478?transport=udp
TURN_URL_TCP=turn:turn.yourdomain.com:3478?transport=tcp
TURN_URL_TLS=turns:turn.yourdomain.com:5349?transport=tcp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_password

# Alternative: JSON array for advanced multi-region TURN configurations
# TURN_SERVERS=[{"urls":["turn:t1.yourdomain.com:3478?transport=udp"],"username":"u1","credential":"p1"}]

# ─── SSL / TLS (optional — only needed for native HTTPS without a reverse proxy) ──
# SSL_KEY_PATH=/path/to/privkey.pem
# SSL_CERT_PATH=/path/to/fullchain.pem
# SSL_PFX_PATH=/path/to/certificate.pfx
# SSL_PASSPHRASE=

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Allow quick-login (bypass password) for demo/testing — DISABLE in production
ALLOW_QUICK_LOGIN=false

# Max participants in a group P2P mesh call room (default: 6)
MAX_MESH_PARTICIPANTS=6


# ==============================================================================
# HDTalk - Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to Git.
# ==============================================================================

# ── Server Core ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# ── JWT Authentication (REQUIRED) ─────────────────────────────────────────────
# Generate a strong 384-bit secret using: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters_random
JWT_EXPIRES_IN=7d

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hdtalk?retryWrites=true&w=majority

# ── Web Push / VAPID (REQUIRED) ───────────────────────────────────────────────
# Generate keypair using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your-email@example.com

# ── n8n Automation & AI Webhooks (Optional) ───────────────────────────────────
N8N_ENABLED=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hdtalk
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_secret_here

# ── WebRTC STUN / TURN (Optional) ─────────────────────────────────────────────
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL_UDP=
TURN_URL_TCP=
TURN_USERNAME=
TURN_CREDENTIAL=

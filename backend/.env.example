# HDTalk Server Configuration
# Created by Himanshu Dwivedi

PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173
JWT_SECRET=hdtalk_production_super_jwt_secret_key_change_me_in_prod_2026
DATA_DIR=./data
UPLOAD_DIR=./uploads
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hdtalk
N8N_ENABLED=true

# WebRTC STUN & TURN Infrastructure
# Comma-separated list of STUN servers (defaults to Google public STUN if unset)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Dedicated Coturn Server Credentials (UDP, TCP, and TLS endpoints)
# Never hardcode production TURN credentials or secrets in client code.
TURN_URL_UDP=turn:turn.yourdomain.com:3478?transport=udp
TURN_URL_TCP=turn:turn.yourdomain.com:3478?transport=tcp
TURN_URL_TLS=turns:turn.yourdomain.com:5349?transport=tcp
TURN_USERNAME=hdtalk_webrtc_prod
TURN_CREDENTIAL=StrongGeneratedTurnPassword2026!

# Alternative: JSON array for advanced multi-region TURN configurations
# TURN_SERVERS=[{"urls":["turn:turn1.yourdomain.com:3478?transport=udp","turns:turn1.yourdomain.com:5349?transport=tcp"],"username":"u1","credential":"p1"}]


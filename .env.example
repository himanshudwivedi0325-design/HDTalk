# HDTalk Production Environment Configuration
# Created with ❤️ by Himanshu Dwivedi

# ----------------------------------------------------
# 1. CORE SERVER SETTINGS
# ----------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://hdtalk.onrender.com,http://localhost:5173
JWT_SECRET=chatz_ultra_jwt_super_secret_key_2026

# ----------------------------------------------------
# 2. HOSTED DATABASE (MongoDB Atlas / PostgreSQL)
# ----------------------------------------------------
# Provide your free MongoDB Atlas cluster connection string.
# When provided, HDTalk automatically performs a 1-time automated migration
# from db.json with ZERO data loss, and enables limitless concurrent user capacity!
# If left empty, HDTalk automatically uses the rock-solid local db.json engine.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hdtalk?retryWrites=true&w=majority

# ----------------------------------------------------
# 3. CLOUD MEDIA STORAGE (Cloudinary Global CDN)
# ----------------------------------------------------
# Provide your free Cloudinary credentials from cloudinary.com dashboard.
# When configured, all chat photos, voice notes, attachments, and profile avatars
# are permanently streamed to Cloudinary CDN with lifetime retention (immune to container restarts).
# If left empty, files are stored on local disk in /uploads fallback.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# OR single URL format:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ----------------------------------------------------
# 4. BACKGROUND WEB PUSH NOTIFICATIONS (VAPID RFC-8292)
# ----------------------------------------------------
# Built-in default VAPID keys are already active out-of-the-box.
# You may optionally supply your own custom VAPID keys:
VAPID_PUBLIC_KEY=BJ6_MpjdnYd2kS9DwgOXmTpiYMsrigU32AXo8vL6Bi-xxZKMEpA2qTNvGneshh-DBp8cIOXo3bV0BeGAkkcFPzA
VAPID_PRIVATE_KEY=jFoClphDQQTzFz5WRhzgajXfA5sAevoRcWNrEtnRPmk
VAPID_EMAIL=mailto:himanshudwivedi0325@gmail.com

# ----------------------------------------------------
# 5. WEBRTC STUN & TURN RELAY SERVERS
# ----------------------------------------------------
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

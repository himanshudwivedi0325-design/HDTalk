# ==============================================================================
# HDTalk - Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or credentials to Git.
# ==============================================================================

# ── Server Core ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:5173

# ── JWT Authentication (REQUIRED) ─────────────────────────────────────────────
# Generate a strong 64-byte secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_MUST_BE_64_BYTES_MIN_USE_CRYPTO_RANDOM
JWT_EXPIRES_IN=7d

# ── Platform Creator Emails (OPTIONAL) ────────────────────────────────────────
# Comma-separated emails of platform creators (get permanent admin rights)
# NEVER hardcode these in source code — always use this env variable
PLATFORM_CREATOR_EMAILS=your-admin@example.com

# ── Seed Admin Password (REQUIRED in production) ───────────────────────────────
# Password for the initial admin user created during first-time DB seed.
# REQUIRED in production (server will refuse to start if not set).
# In development: auto-generates a random password if not set.
SEED_ADMIN_PASSWORD=your_strong_admin_password_here_min_12_chars

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hdtalk?retryWrites=true&w=majority

# ── Web Push / VAPID (REQUIRED) ───────────────────────────────────────────────
# Generate keypair using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:your-email@example.com

# ── n8n Automation & AI Webhooks (Optional) ───────────────────────────────────
N8N_ENABLED=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hdtalk
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_secret_here

# ── WebRTC STUN / TURN (Optional) ─────────────────────────────────────────────
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL_UDP=
TURN_URL_TCP=
TURN_USERNAME=
TURN_CREDENTIAL=
